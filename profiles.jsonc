{
  "clipboard": {
    "description": "pbcopy and pbpaste, for copying out of the TUI on a terminal without OSC 52.",
    "extraDomains": [],
    "extraRead": [],
    "extraWrite": [],
    "allowMachLookup": [
      // The pasteboard server. Without it pbcopy exits 1, and Claude reports a
      // successful copy regardless: it spawns pbcopy without awaiting it.
      //
      // The grant is two-way. pbpaste starts working at the same time, so
      // whatever is on the host clipboard is readable inside the sandbox.
      "com.apple.pasteboard.1"
    ],
    "requiredEnv": []
  },
  "gh": {
    "description": "The GitHub CLI, against the REST and GraphQL API only.",
    "extraDomains": [
      // REST and GraphQL both.
      "api.github.com"
      // Note that github.com is absent because the OAuth device flow lives
      // at https://github.com/login/device/code.
    ],
    "extraRead": [
      // config.yml and hosts.yml, which gh refuses to start without.
      "~/.config/gh"
    ],
    "extraWrite": [],
    "allowMachLookup": [
      // gh is a Go binary, and Go on macOS verifies TLS through the Security
      // framework rather than a CA bundle, so without this every request fails
      // with `x509: OSStatus -26276`. srt warns that trustd is an exfiltration
      // path in its own right — one that does not go through the proxy, and so
      // is not bounded by the domain allowlist.
      "com.apple.trustd.agent"
    ],
    "requiredEnv": [
      // The GitHub token that gh will use.
      "GH_TOKEN"
    ]
  },
  "git-writable": {
    "description": "Local git writes — add, commit, branch, stash, rebase. Push remains denied.",
    "extraDomains": [
      // github.com is *not* allow-listed, so pushes won't work.
    ],
    "extraRead": [],
    "extraWrite": [],
    "denyWriteOverrides": {
      "**/.git": [
        // srt's own mandatory denies close .git/hooks and .git/config in the
        // workspace and in any repository nested in it. A submodule's or a
        // worktree's gitdir has neither pair of path segments, so those are
        // named here.
        "**/.git/modules/**/hooks",
        "**/.git/worktrees/**/hooks",
        "**/.git/modules/**/config",
        "**/.git/config.worktree",
        "**/.git/modules/**/config.worktree",
        "**/.git/worktrees/**/config.worktree"
      ]
    },
    "allowMachLookup": [],
    "requiredEnv": []
  },
  "node": {
    "description": "Node toolchains installed under $HOME, so package scripts run in the workspace.",
    "extraDomains": [],
    "extraRead": [
      // nvm. Each version lands in versions/node/<version>, with that version's
      // bin/ — node, npm, npx, and the corepack shims for pnpm and yarn — on
      // PATH once nvm has been sourced from a shell rc file.
      "~/.nvm",
      // nvm again, where it goes when XDG_CONFIG_HOME is set.
      "~/.config/nvm",
      // nodenv, whose shims/ dispatch to versions/<version>.
      "~/.nodenv",
      // A standalone pnpm — the installer script rather than corepack — on the
      // XDG layout. This is PNPM_HOME, holding the pnpm binary and the global
      // content-addressable store beneath it.
      "~/.local/share/pnpm",
      // The same standalone pnpm at its macOS default, which is where `pnpm
      // store path` reports on this machine.
      "~/Library/pnpm",
      // The two conventional homes for an npm prefix moved out of /usr/local,
      // which is where `npm install -g pnpm` then puts it.
      "~/.npm-global",
      "~/.npm-packages",
      // Corepack's download cache, which holds the pnpm and yarn it dispatches
      // to.
      "~/.cache/node"
    ],
    "extraWrite": [],
    "allowMachLookup": [],
    "requiredEnv": []
  },
  "node-modules-writable": {
    "description": "node_modules, at any depth, for tools that transpile into it. Select it beside 'node'.",
    "extraDomains": [],
    "extraRead": [],
    "extraWrite": [],
    "denyWriteOverrides": {
      // Open up node_modules entirely.
      "**/node_modules": []
    },
    "allowMachLookup": [],
    "requiredEnv": []
  }
}
