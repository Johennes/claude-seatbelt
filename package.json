{
  "name": "claude-seatbelt",
  "version": "0.1.0",
  "private": true,
  "description": "Run claude on the host under Anthropic's sandbox-runtime",
  "type": "module",
  "bin": {
    "claude-seatbelt": "dist/claude-seatbelt.js"
  },
  "files": [
    "dist",
    "profiles.jsonc"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/claude-seatbelt.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings src tests",
    "lint:fix": "oxlint --deny-warnings --fix src tests",
    "format": "oxfmt src tests",
    "format:check": "oxfmt --check src tests",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "prestart": "pnpm run build",
    "start": "node dist/claude-seatbelt.js",
    "pretest": "pnpm run build",
    "test": "node --test tests/*.test.ts",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.23.0"
}
